---
import { url } from '../lib/url';
---

<div class="search-backdrop" id="search-backdrop" hidden data-search-url={url('/search.json')}>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search posts">
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Search posts… / 搜索文章…"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <ul class="search-results" id="search-results" role="listbox" aria-label="Results"></ul>
    <div class="search-hint">
      <span>↑↓ move</span><span>↵ open</span><span>esc close</span>
    </div>
  </div>
</div>

<script>
  type Doc = {
    title: string;
    url: string;
    date: string;
    tag: string;
    lang: string;
    body: string;
  };

  const backdrop = document.getElementById('search-backdrop') as HTMLElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLElement | null;
  const trigger = document.getElementById('search-trigger');

  if (backdrop && input && list) {
    const SEARCH_URL = backdrop.dataset.searchUrl || '/search.json';

    let docs: Doc[] | null = null;
    let loading = false;
    let active = -1;
    let current: Doc[] = [];
    let lastFocus: HTMLElement | null = null;

    const esc = (s: string) =>
      String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    const reEsc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    // Highlight after escaping, so the needle is matched against escaped text.
    const highlight = (text: string, needle: string) => {
      const safe = esc(text);
      if (!needle) return safe;
      return safe.replace(new RegExp(`(${reEsc(esc(needle))})`, 'ig'), '<mark>$1</mark>');
    };

    async function loadIndex() {
      if (docs || loading) return;
      loading = true;
      try {
        const res = await fetch(SEARCH_URL, { credentials: 'same-origin' });
        docs = res.ok ? await res.json() : [];
      } catch {
        docs = [];
      } finally {
        loading = false;
      }
    }

    function score(doc: Doc, q: string) {
      const t = doc.title.toLowerCase();
      const i = t.indexOf(q);
      if (i === 0) return 100;
      if (i > 0) return 70;
      if (doc.tag.toLowerCase().indexOf(q) === 0) return 50;
      if (doc.body.toLowerCase().includes(q)) return 20;
      return 0;
    }

    function snippet(doc: Doc, q: string) {
      const i = doc.body.toLowerCase().indexOf(q);
      if (i < 0) return '';
      const start = Math.max(0, i - 30);
      return (start > 0 ? '…' : '') + doc.body.slice(start, start + 90).trim() + '…';
    }

    function syncActive() {
      Array.from(list!.children).forEach((li, i) => {
        const on = i === active;
        li.classList.toggle('is-active', on);
        if (li.getAttribute('role') === 'option') li.setAttribute('aria-selected', String(on));
      });
      input!.setAttribute('aria-activedescendant', active > -1 ? `sr-${active}` : '');
    }

    function render(q: string) {
      current = q
        ? (docs ?? [])
            .map((d) => ({ d, s: score(d, q) }))
            .filter((x) => x.s > 0)
            .sort((a, b) => b.s - a.s)
            .slice(0, 8)
            .map((x) => x.d)
        : [];

      active = current.length ? 0 : -1;

      if (!q) {
        list!.innerHTML = '';
        input!.setAttribute('aria-expanded', 'false');
        return;
      }
      if (!current.length) {
        list!.innerHTML = '<li class="search-empty">No matching posts.</li>';
        input!.setAttribute('aria-expanded', 'false');
        return;
      }

      input!.setAttribute('aria-expanded', 'true');
      list!.innerHTML = current
        .map((d, i) => {
          const snip = snippet(d, q);
          const meta = [d.date, d.tag ? `#${d.tag}` : '', d.lang].filter(Boolean).join(' · ');
          return (
            `<li role="option" id="sr-${i}" aria-selected="${i === 0}">` +
            `<a href="${esc(d.url)}">` +
            `<div class="search-result__title">${highlight(d.title, q)}</div>` +
            `<div class="search-result__meta">${esc(meta)}</div>` +
            (snip ? `<div class="search-result__meta">${highlight(snip, q)}</div>` : '') +
            `</a></li>`
          );
        })
        .join('');
      syncActive();
    }

    function move(delta: number) {
      if (!current.length) return;
      active = (active + delta + current.length) % current.length;
      syncActive();
      (list!.children[active] as HTMLElement | undefined)?.scrollIntoView({ block: 'nearest' });
    }

    async function open() {
      if (!backdrop!.hidden) return;
      lastFocus = document.activeElement as HTMLElement | null;
      backdrop!.hidden = false;
      document.body.style.overflow = 'hidden';
      input!.focus();
      input!.select();
      await loadIndex();
      if (input!.value) render(input!.value.trim().toLowerCase());
    }

    function close() {
      if (backdrop!.hidden) return;
      backdrop!.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    trigger?.addEventListener('click', open);
    trigger?.addEventListener('mouseenter', loadIndex, { once: true });

    input.addEventListener('input', async () => {
      await loadIndex();
      render(input.value.trim().toLowerCase());
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter') {
        const href = list.children[active]?.querySelector('a')?.getAttribute('href');
        if (href) {
          e.preventDefault();
          window.location.href = href;
        }
      }
    });

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) close();
    });

    list.addEventListener('mousemove', (e) => {
      const li = (e.target as HTMLElement).closest('li[role="option"]');
      if (!li) return;
      const idx = Array.from(list.children).indexOf(li);
      if (idx > -1 && idx !== active) {
        active = idx;
        syncActive();
      }
    });

    document.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (mod && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        open();
        return;
      }
      if (e.key === 'Escape' && !backdrop.hidden) {
        e.preventDefault();
        close();
        return;
      }
      // Bare "/" opens search, unless the user is typing somewhere.
      if (e.key === '/' && backdrop.hidden && !mod) {
        const t = e.target as HTMLElement | null;
        const tag = t?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || t?.isContentEditable) return;
        e.preventDefault();
        open();
      }
    });
  }
</script>
