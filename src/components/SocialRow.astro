---
import { site } from '../site.config';
import { url } from '../lib/url';

/* Split the rotated address at the `@` so the markup carries no
   name@host-shaped string at all — a harvester's regex finds nothing to
   match, rather than matching and collecting a rotated decoy. */
const [emailUser = '', emailHost = ''] = site.emailRot13.split('@');
---

<div class="social">
  <a href={`https://github.com/${site.github}`} title="GitHub">
    <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
      ><path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
      ></path></svg
    >github</a
  >

  {
    site.scholarUrl && (
      <a href={site.scholarUrl} title="Google Scholar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" />
        </svg>
        scholar
      </a>
    )
  }

  {
    site.twitter && (
      <a href={`https://twitter.com/${site.twitter}`} title="Twitter">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        twitter
      </a>
    )
  }

  {
    /* No `href` in the markup, and the address is ROT13'd and split — see
       site.config. The script below reassembles it and attaches the real
       mailto: on the first hover, focus or tap. An <a> with no href is not
       focusable, hence the explicit role and tabindex — otherwise the link
       would be keyboard-dead until a mouse touched it. Without JS the label
       stays as plain, unlinked text. */
    emailUser && emailHost && (
      <a
        class="social__email"
        data-u={emailUser}
        data-h={emailHost}
        role="link"
        tabindex="0"
        title="Email">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true">
          <rect x="2.5" y="5" width="19" height="14" rx="2" />
          <path d="m3 6.5 9 6.5 9-6.5" />
        </svg>
        email
      </a>
    )
  }

  <a href={url('/rss.xml')} title="RSS">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><circle cx="5" cy="19" r="2.2"></circle><path
        d="M3 10.5A10.5 10.5 0 0 1 13.5 21h3A13.5 13.5 0 0 0 3 7.5v3zM3 4.5A16.5 16.5 0 0 1 19.5 21h3A19.5 19.5 0 0 0 3 1.5v3z"
      ></path></svg
    >rss</a
  >
</div>

<script>
  /* ROT13 is its own inverse: the same rotation that encoded the address in
     site.config decodes it back here, and the two halves are rejoined around
     an `@` that was never in the HTML. Bulk harvesters scrape with a regex
     and find nothing address-shaped on the page. A headless browser running
     this script still would — the cheap, high-volume half of the problem is
     the half worth spending a few lines on. */
  const rot13 = (s: string) =>
    s.replace(/[a-z]/gi, (c) => {
      const base = c <= 'Z' ? 65 : 97;
      return String.fromCharCode(((c.charCodeAt(0) - base + 13) % 26) + base);
    });

  for (const el of document.querySelectorAll<HTMLAnchorElement>('a.social__email[data-u]')) {
    const reveal = () => {
      const { u, h } = el.dataset;
      if (!u || !h) return;
      el.href = `mailto:${rot13(u)}@${rot13(h)}`;
      el.removeAttribute('data-u');
      el.removeAttribute('data-h');
    };

    /* Hover or focus reveals ahead of the click on desktop; the click and
       keydown handlers cover touch and keyboard, where the first interaction
       has to both reveal the address and follow it. */
    const follow = () => {
      reveal();
      if (el.href) window.location.href = el.href;
    };

    el.addEventListener('pointerenter', reveal, { once: true });
    el.addEventListener('focus', reveal, { once: true });
    el.addEventListener('click', (e) => {
      if (el.href) return; // already a real link — let the browser handle it
      e.preventDefault();
      follow();
    });
    el.addEventListener('keydown', (e) => {
      if (el.href || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      follow();
    });
  }
</script>
