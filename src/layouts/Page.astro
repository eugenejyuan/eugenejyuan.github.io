---
import Base from './Base.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  /** Breadcrumb tail, e.g. "WRITING". Defaults to the uppercased title. */
  eyebrow?: string;
  description?: string;
  /** Tighter title margin, for pages with a subtitle line underneath. */
  tight?: boolean;
  /** Widen the column — for index-style pages that read as a table. */
  wide?: boolean;
  /** JSON-LD nodes for this page. Built by src/lib/schema.ts. */
  schema?: unknown[];
}

const {
  title,
  eyebrow,
  description,
  tight = false,
  wide = false,
  schema = [],
} = Astro.props;
---

<Base title={title} description={description} wide={wide} schema={schema}>
  <div class="eyebrow">
    <a href={url('/')}>← WORKING NOTES</a> / {eyebrow ?? title.toUpperCase()}
  </div>

  <h1 class={`title-page${tight ? ' title-page--tight' : ''}`}>{title}</h1>

  <slot />
</Base>
