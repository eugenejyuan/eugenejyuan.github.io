---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
import { inline, plain, isoDate, dottedDate } from '../lib/inline';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Older post. */
  prev?: Post;
  /** Newer post. */
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, date, lang, tag, read, revised, abstract, refs } = post.data;

const description = abstract ? plain(abstract).slice(0, 200) : site.description;
---

<Base title={title} description={description} lang={lang} ogType="article">
  <div class="eyebrow eyebrow--center">
    <a href={url('/')}>← WORKING NOTES</a> / {dottedDate(date)}
  </div>

  <h1 class="post-title">{title}</h1>
  <div class="post-author">{site.author}</div>

  <div class="post-meta">
    {read && <>{read} read · </>}
    <a href={url(`/posts?tag=${encodeURIComponent(tag)}`)}>#{tag}</a>
    {revised && <> · revised {isoDate(revised)}</>}
  </div>

  {
    abstract && (
      <>
        <div class="label">ABSTRACT</div>
        <p class="post-abstract" set:html={inline(abstract)} />
      </>
    )
  }

  <hr class="rule" />

  <div class="prose">
    <slot />
  </div>

  {
    refs.length > 0 && (
      <>
        <div class="refs-head">── References ─────────────────────────────────</div>
        <div class="refs">
          <ol>
            {refs.map((r) => (
              <li set:html={inline(r)} />
            ))}
          </ol>
        </div>
      </>
    )
  }

  <hr class="rule" style="margin:30px 0 12px" />

  <nav class="post-nav" aria-label="More posts">
    {
      prev ? (
        <a class="post-nav__prev" href={url(`/posts/${prev.id}`)} title={prev.data.title}>
          ← prev
        </a>
      ) : (
        <a class="post-nav__prev" href={url('/posts')}>
          ← all posts
        </a>
      )
    }
    {
      next ? (
        <a class="post-nav__next" href={url(`/posts/${next.id}`)} title={next.data.title}>
          next →
        </a>
      ) : (
        <a class="post-nav__next" href={url('/posts')}>
          all posts →
        </a>
      )
    }
  </nav>
</Base>
