---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found" description="That note doesn't exist." noindex>
  <div class="notfound">
    <div class="notfound__code">404</div>
    <h1 class="title-page" style="margin:22px 0 10px">Page not found</h1>
    <p class="muted" style="font-style:italic;margin:0 0 26px">
      That note doesn't exist — or it was renamed while being revised in public.
    </p>
    <p class="mono-link">
      <a href={url('/')}>← working notes</a>
      &nbsp;·&nbsp;
      <a href={url('/posts')}>all posts</a>
    </p>
  </div>
</Base>
