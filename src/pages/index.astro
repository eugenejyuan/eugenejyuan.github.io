---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { news } from '../data/news';
import { allPosts } from '../lib/posts';
import { url } from '../lib/url';
import { langBadge, isoDate } from '../lib/inline';
import { person, webSite } from '../lib/schema';

const posts = await allPosts();
const recent = posts.slice(0, 5);

const now = new Date();
const version = `v${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}`;
---

<Base schema={[webSite(Astro.site), person(Astro.site)]}>
  <div class="eyebrow eyebrow--center">WORKING NOTES · {version}</div>

  <h1 class="title-home">{site.title}</h1>
  <div class="byline">by {site.author}</div>
  <div class="subline">
    {site.location} ·
    <a href={url('/about')}>about</a> /
    <a href={`https://github.com/${site.github}`}>github</a> /
    <a href={url('/rss.xml')}>rss</a>
  </div>

  <div class="label">ABSTRACT</div>
  <p class="abstract">{site.description}</p>
  <div class="mono-note interests">{site.interests}</div>

  <hr class="rule" />

  <h2>1.&nbsp; Recent posts</h2>
  <div class="stack">
    {
      recent.map((post) => (
        <div class="post-row">
          <span class="post-row__date">{isoDate(post.data.date)}</span>
          <span class="post-row__lang">[{langBadge(post.data.lang)}]</span>
          <a class={`post-row__title${post.data.lang === 'zh' ? ' cjk' : ''}`} href={url(`/posts/${post.id}`)}>{post.data.title}</a>
        </div>
      ))
    }
  </div>
  <p style="margin:14px 0 0">
    <a class="mono-link" href={url('/posts')}>→ all posts ({posts.length})</a>
  </p>

  <h2>2.&nbsp; News</h2>
  <div class="stack stack--sm">
    {
      news.map((item) => (
        <div class="news-row">
          <span class="news-row__date">{item.date}</span>
          <span set:html={item.text} />
        </div>
      ))
    }
  </div>

  <p style="margin:24px 0 0">
    <a class="mono-link" href={url('/about')}>→ research &amp; publications</a>
  </p>
</Base>
